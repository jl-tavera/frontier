# Copy to .env and fill. The app refuses to start while a required var is unset.
# Run locally with: uv run --env-file .env uvicorn app.main:app

# Required
TEAM_TOKEN=change-me                       # Bearer token the evaluator sends on /tasks
OPENROUTER_API_KEY=sk-or-...               # every LLM call goes through OpenRouter
MODEL_FAST=provider/fast-model-id          # parse + summary
MODEL_VLM=provider/vision-model-id         # re-grounding with the SoM image
MODEL_PLANNER=provider/planner-model-id    # fallback tool-use loop

# Optional
TYPESAFE_API_KEY=                          # Jev (typesafe-sdk); without it rung 1 skips Jev
LOG_DIR=logs                               # one <task_id>.jsonl per task

# POC only (poc/rfb_poc.py); the service gets the desktop per task, never from env
URL=
PASSWORD=
